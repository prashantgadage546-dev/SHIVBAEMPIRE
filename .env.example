# =============================================================
# SHIVBAEMPIRE — Environment Variables Template
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# =============================================================

# ---- Node ----
NODE_ENV=development
PORT=5000

# ---- MySQL Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shivbaempire
DB_USER=shivba_user
DB_PASSWORD=your_strong_db_password_here
DB_ROOT_PASSWORD=your_strong_root_password_here

# ---- JWT ----
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=24h

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173

# ---- Application ----
APP_NAME=SHIVBAEMPIRE
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# ---- Receipt ----
RECEIPT_PREFIX=YAT
RECEIPT_YEAR=2026

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Production (VPS) — fill these on the VPS only ----
# APP_URL=https://yourdomain.com
# API_URL=https://yourdomain.com/api
# CORS_ORIGIN=https://yourdomain.com
