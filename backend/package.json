{
  "name": "shivbaempire-backend",
  "version": "1.0.0",
  "description": "SHIVBAEMPIRE Backend API - Shivba Tarun Mitra Mandal",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit",
    "migrate": "node src/utils/migrate.js",
    "seed": "node src/utils/seed.js",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "alasql": "^4.18.0",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.3",
    "sqlite3": "^6.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterFramework": []
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "sqlite3@6.0.1": true
  }
}
